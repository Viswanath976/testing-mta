# Generated by KumoMTA Automation - traffic shaping ({{ shaping_preset }} preset). Do not edit by hand.
# Per-destination-ISP limits, layered on top of the community shaping.toml base.
{% for b in shaping_blocks %}
{% for d in b.domains %}
["{{ d }}"]
mx_rollup = true
connection_limit = {{ b.connection_limit }}
max_connection_rate = "{{ b.max_connection_rate }}"
max_message_rate = "{{ b.max_message_rate }}"
max_deliveries_per_connection = {{ b.max_deliveries_per_connection }}
idle_timeout = "60s"

{% endfor %}
{% endfor %}
["default"]
connect_timeout = "15s"
ip_lookup_strategy = "Ipv4Only"
