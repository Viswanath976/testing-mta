-- Generated by KumoMTA Automation ({{ environment }} profile). Do not edit by hand.
local kumo = require 'kumo'
local sources = require 'policy-extras.sources'
local queue_module = require 'policy-extras.queue'
local listener_domains = require 'policy-extras.listener_domains'
{% if shaping_enabled %}
local shaping = require 'policy-extras.shaping'
{% endif %}
{% if dkim_enabled %}
local dkim_sign = require 'policy-extras.dkim_sign'
-- policy-extras DKIM signer: reads dkim_data.toml and signs with the per-domain
-- key on disk (/opt/kumomta/etc/dkim/<domain>/<selector>.key). This is the
-- supported helper path, not a hand-rolled per-domain signer.
local dkim_signer = dkim_sign:setup { '/opt/kumomta/etc/policy/dkim_data.toml' }
{% endif %}

-- Watch our generated data files so runtime edits hot-reload. Also required by
-- the queue helper: it calls kumo.validation_failed() if its data file (queues.toml)
-- is not covered by these globs, so this must include the policy dir.
kumo.set_config_monitor_globs {
  '/opt/kumomta/etc/policy/*.toml',
  '/opt/kumomta/etc/policy/*.json',
}

kumo.on('init', function()
  kumo.define_spool { name = 'data', path = '/var/spool/kumomta/data' }
  kumo.define_spool { name = 'meta', path = '/var/spool/kumomta/meta' }
  kumo.configure_local_logs { log_dir = '/var/log/kumomta', max_segment_duration = '{{ max_segment_duration }}' }

  -- local injection (health checks / internal) — localhost only, off the
  -- submission ports so it never collides with 2525 client submission.
  kumo.start_esmtp_listener { listen = '127.0.0.1:2526', relay_hosts = { '127.0.0.1' } }
  -- authenticated client submission listeners. Relay is authorized per-user via
  -- listener_domains (relay_from_authz), NOT relay_hosts, so these bind 0.0.0.0
  -- but only signed-in users can relay out. The firewall allow-lists these ports.
{% for port in submission_ports %}
  kumo.start_esmtp_listener { listen = '0.0.0.0:{{ port }}' }
{% endfor %}
  -- metrics / admin API ({{ 'exposed to monitoring hub' if monitoring_hub else 'localhost only' }})
  kumo.start_http_listener { listen = '{{ "0.0.0.0" if monitoring_hub else "127.0.0.1" }}:8000',
    trusted_hosts = { '127.0.0.1', '::1'{% if monitoring_hub %}, '{{ monitoring_hub }}'{% endif %} } }
end)

{% if shaping_enabled %}
-- per-destination-ISP traffic shaping (community base + our generated overrides).
-- MUST run before the queue module is set up: shaping.lua also registers a
-- get_queue_config handler, and KumoMTA requires queue.lua to register LAST.
shaping:setup {
  '/opt/kumomta/share/policy-extras/shaping.toml',
  '/opt/kumomta/etc/policy/shaping_custom.toml',
}
{% endif %}
sources:setup { '/opt/kumomta/etc/policy/sources.toml' }
queue_module:setup { '/opt/kumomta/etc/policy/queues.toml' }

-- Relay authorization: which domains we accept mail FOR, and which authenticated
-- users may relay OUT. relay_from_authz is matched against conn_meta 'authz_id'
-- (set in smtp_server_auth_plain below) — this is what fixes "550 relaying not
-- permitted" for authenticated client submission.
kumo.on('get_listener_domain',
  listener_domains:setup { '/opt/kumomta/etc/policy/listener_domains.toml' })

{% if not shaping_enabled %}
-- proven operational defaults.
-- Only when shaping is OFF: with shaping on, policy-extras/shaping owns
-- get_egress_path_config and these live in the shaping "default" block instead
-- (a second handler here conflicts with shaping and fails validation).
kumo.on('get_egress_path_config', function(domain, egress_source, site_name)
  return kumo.make_egress_path {
    ip_lookup_strategy = 'Ipv4Only',   -- our IPs are IPv4-only
    connect_timeout = '15s',           -- fail over fast on dead MX
  }
end)
{% endif %}

-- AUTH PLAIN over STARTTLS; username selects the sending IP + sending domain
local shared_ip_indexes = {}
kumo.on('smtp_server_auth_plain', function(authz, authc, password, conn_meta)
  local a = kumo.json_load '/opt/kumomta/etc/policy/smtp-auth.json'
  local ip = a.users[authc]
  if ip and a.passwords[authc] and password == a.passwords[authc] then
    if type(ip) == 'table' then
      local next_index = (shared_ip_indexes[authc] or 0) + 1
      if next_index > #ip then next_index = 1 end
      shared_ip_indexes[authc] = next_index
      ip = ip[next_index]
    end
    conn_meta:set_meta('sending_ip', ip)
    -- listener_domains relay_from_authz matches on 'authz_id'; set it to the
    -- authenticated login so this user is allowed to relay outbound.
    conn_meta:set_meta('authz_id', authc)
    if a.domains and a.domains[authc] then
      conn_meta:set_meta('sending_domain', a.domains[authc])
    end
    return true
  end
  return false
end)

kumo.on('smtp_server_message_received', function(msg, conn_meta)
{% if hide_received %}
  -- Hide the sending infrastructure: strip the Received header carrying this
  -- server's hostname + main IP so it never appears in delivered mail.
  msg:remove_all_named_headers('Received')
{% endif %}
  local ip, domain
  if conn_meta then
    ip = conn_meta:get_meta 'sending_ip'
    domain = conn_meta:get_meta 'sending_domain'
  end
  if not ip or ip == '' then ip = msg:get_first_named_header_value 'X-Send-IP' end
  if ip and ip ~= '' then msg:set_meta('tenant', 'tenant-' .. ip) end
  -- Return-Path: only set when the client did NOT supply an envelope sender
  -- (a client-provided Return-Path / MAIL FROM is left exactly as given).
  local _s = msg:sender()
  if not _s or _s.domain == nil or _s.domain == '' then
    local _fh = msg:from_header()
    local _bounce = (_fh and _fh.domain) or domain or '{{ default_bounce_domain }}'
    if _bounce and _bounce ~= '' then msg:set_sender('bounces@' .. _bounce) end
  end
{% if dkim_enabled %}
  -- DKIM sign via the policy-extras signer. It picks the key by the message's
  -- domain from dkim_data.toml; wrapped in pcall so a missing-key domain can't
  -- abort acceptance (unsigned mail still queues rather than 4xx/5xx).
  pcall(function() dkim_signer(msg) end)
{% endif %}
end)
