# Copy to .env and fill in. The web backend reads these on startup.

# --- PostgreSQL: where ALL data is stored -----------------------------------
# Production (your Postgres):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kumo_automation
# Local default if unset: sqlite:///./kumo.db

# --- Secret encryption key (encrypts SMTP/SSH passwords + cPanel tokens) -----
# Use a long random string. Changing it makes existing stored secrets unreadable.
SECRET_KEY=change-me-to-a-long-random-string

# --- Web frontend origin(s) allowed to call the API (CORS) ------------------
FRONTEND_ORIGINS=http://localhost:3000

# --- Where DB backups are written -------------------------------------------
BACKUP_DIR=./backups
